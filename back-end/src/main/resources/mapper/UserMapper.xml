<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wcw.backend.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.wcw.backend.entity.User">
        <id property="id" column="id" />
        <result property="username" column="username" />
        <result property="password" column="password" />
        <result property="email" column="email" />
        <result property="address" column="address" />
        <result property="createTime" column="create_time" />
        <result property="role" column="role" />
    </resultMap>

    <select id="findAll" resultMap="UserResultMap">
        SELECT * FROM user
    </select>
    
    <select id="selectPage" resultMap="UserResultMap">
            SELECT * FROM user WHERE username LIKE #{username} LIMIT #{pageNum}, #{pageSize}
    </select>

    <select id="selectTotal" resultType="Integer">
        SELECT COUNT(*) FROM user WHERE username LIKE concat('%', #{username}, '%')
    </select>
</mapper>