<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wcw.backend.mapper.WeightFileInfoMapper">
    <insert id="save" parameterType="com.wcw.backend.entity.WeightFileInfo">
        INSERT INTO weight_file_info (weight_file_id, epoch)
        VALUES (#{weightFileId}, #{epoch})
    </insert>

    <select id="findAll" resultType="com.wcw.backend.entity.WeightFileInfo">
        SELECT * FROM weight_file_info
    </select>
</mapper>
